<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c5a0b4ee-3f2f-48ca-a499-ede30f6308c5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- No Microsoft.AspNetCore.OpenApi: SergioIzq.AspNetCore.Kernel brings Swashbuckle-based Swagger (AddKernelSwagger) instead. -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SergioIzq.AspNetCore.Kernel" Version="0.2.6" />
    <PackageReference Include="SergioIzq.Logging.HtmlFile" Version="0.2.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Synap.Application\Synap.Application.csproj" />
    <ProjectReference Include="..\Synap.Infrastructure\Synap.Infrastructure.csproj" />
    <ProjectReference Include="..\Synap.Shared.Application\Synap.Shared.Application.csproj" />
  </ItemGroup>

</Project>
